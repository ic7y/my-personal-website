<!--
  页面: 桌台列表 / 桌台详情
  说明: 根据登录身份(`role`)显示所有桌台(管理员)或单个桌台(普通用户或通过二维码进入)
  调试信息: 顶部会输出 openId/unionId/role/loading/tables.length 便于排查数据加载问题
-->
<view class="container">
  <view class="card">
    <view style="display:flex;justify-content:space-between;align-items:center;gap:12rpx;flex-wrap:wrap;">
      <view>
        <view style="font-size:28rpx;color:#8a8f99;">桌台计时小程序</view>
        <view style="font-size:40rpx;font-weight:600;">
          <text wx:if="role === 'admin'">所有桌台使用情况</text>
          <text wx:else>桌台使用查询</text>
        </view>
      </view>
      <view style="display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;">
        <button wx:if="role === 'admin'" type="primary" bindtap="openAddModal" style="padding:10rpx 18rpx;font-size:24rpx;border-radius:18rpx;">新增桌台</button>
        <button wx:if="role === 'admin'" type="default" bindtap="goOrderHistory" style="padding:10rpx 18rpx;font-size:24rpx;border-radius:18rpx;">历史订单查询</button>
        <view wx:if="role === 'admin'" style="background:#e8f3ff;color:#1c7cd6;padding:8rpx 16rpx;border-radius:999rpx;font-size:24rpx;">管理员</view>
        <view wx:else style="background:#ecfdf3;color:#16a34a;padding:8rpx 16rpx;border-radius:999rpx;font-size:24rpx;">普通用户</view>
      </view>
    </view>
    <view style="margin-top:12rpx;color:#475569;font-size:24rpx;">
      <view>openid：{{openId || '未获取'}}</view>
      <view>unionid：{{unionId || '未获取'}}</view>
      <view style="margin-top:6rpx;color:#2563eb;">登录结果：{{loginResult || '未登录'}}</view>
      <view style="margin-top:6rpx;color:#64748b;">调试：role={{role}} loading={{loading}} tables={{tables.length}}</view>
    </view>
  </view>

<view>
  <view wx:if="{{loading}}">加载中...</view>
  <view wx:elif="{{error}}">{{error}}</view>
  <!-- 原来的这部分 -->
  <view wx:else>
    <view wx:if="{{tables.length === 0}}">暂无桌台</view>
    
    <!-- 父容器：去掉 padding，让卡片紧贴屏幕边缘 -->
    <view wx:else style="display:flex; flex-wrap:wrap; padding:0; box-sizing:border-box;">
      <block wx:for="{{tables}}" wx:key="id">
        <!-- 卡片：去掉边框、外边距、内边距，宽度固定为50% -->
        <view style="width:50%; box-sizing:border-box; background:#fff;">
          <!-- 内部容器，仅保留内边距，确保内容不贴边 -->
          <view style="padding:20rpx 16rpx; border-bottom:1px solid #f0f0f0; <!-- 若不需要分割线可移除 -->">
            
            <!-- 第一行：桌号（独占一行） -->
            <view style="font-size:34rpx; font-weight:600; color:#0f172a; padding-bottom:6rpx;">
              桌号：{{item.tableNumber}}
            </view>
            
            <!-- 第二行：已用时间 + 二维码（横向排列） -->
            <view style="display:flex; align-items:center; gap:12rpx; flex-wrap:wrap; margin-bottom:6rpx;">
              <view style="font-size:26rpx; color:#475569;">
                已用：{{item.used && item.used.formatted ? item.used.formatted : '0分钟'}}
              </view>
              <button 
                type="default" 
                size="mini" 
                bindtap="showQrCode" 
                data-table-id="{{item.id}}" 
                style="padding:4rpx 12rpx; font-size:22rpx; border-radius:16rpx; line-height:1.4;">
                二维码
              </button>
            </view>

            <!-- 第三行：开始/结束时间（点击触发时间修改） -->
            <view style="margin-top:6rpx; font-size:26rpx; color:#334155; display:flex; align-items:center; gap:10rpx; flex-wrap:wrap;">
              <view bindtap="openEditModal" data-table-id="{{item.id}}" style="display:flex; align-items:center; gap:4rpx;">
                <text>开始：</text>
                <text>{{(item.currentOrder && item.currentOrder.start) || item.start || '未设置'}}</text>
              </view>
              <text style="color:#ccc;">|</text>
              <view bindtap="openEditModal" data-table-id="{{item.id}}" style="display:flex; align-items:center; gap:4rpx;">
                <text>结束：</text>
                <text>{{(item.currentOrder && item.currentOrder.end) || item.end || '未设置'}}</text>
              </view>
            </view>

            <!-- 第四行：订单状态（点击触发状态修改） -->
            <view style="margin-top:4rpx; display:flex; align-items:center; gap:10rpx; font-size:26rpx; color:{{item.currentOrderStatusCode === 1 ? '#dc2626' : '#2563eb'}};">
              <view bindtap="modifyOrderStatus" data-table-id="{{item.id}}" style="display:flex; align-items:center; gap:4rpx;">
                <text>状态：</text>
                <text>{{item.currentOrderStatus || '无订单'}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
<block wx:if="{{showQrCode}}">
  <view style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.75);display:flex;justify-content:center;align-items:center;padding:20rpx;z-index:9999;" bindtap="hideQrCode">
    <image src="{{qrCodeImageUrl}}" mode="widthFix" style="max-width:88%;max-height:88%;border-radius:20rpx;background:#fff;"></image>
  </view>
</block>
<block wx:if="{{addModalVisible}}">
  <view style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);display:flex;justify-content:center;align-items:center;padding:20rpx;z-index:10000;">
    <view style="width:92%;background:#fff;border-radius:16rpx;padding:22rpx;">
      <view style="font-size:30rpx;font-weight:600;margin-bottom:12rpx;">新增桌台</view>
      <view style="font-size:24rpx;color:#334155;">桌台号码</view>
      <input value="{{newTableNumber}}" bindinput="onNewTableNumberChange" placeholder="请输入桌台编号" style="margin-top:10rpx;padding:14rpx;border:1px solid #e2e8ef;border-radius:12rpx;font-size:26rpx;" />
      <view style="margin-top:10rpx;color:#64748b;font-size:24rpx;">请输入如 A1、B2 的桌台编号。</view>
      <view style="display:flex;justify-content:flex-end;gap:12rpx;margin-top:18rpx;">
        <button type="default" bindtap="cancelAdd">取消</button>
        <button type="primary" bindtap="createTable">确定</button>
      </view>
      <view wx:if="{{addMessage}}" style="margin-top:12rpx;color:#16a34a;font-size:24rpx;">{{addMessage}}</view>
    </view>
  </view>
</block>
<block wx:if="{{editModalVisible}}">
  <view style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);display:flex;justify-content:center;align-items:center;padding:20rpx;z-index:10000;">
    <view style="width:92%;background:#fff;border-radius:16rpx;padding:20rpx;">
      <view style="font-size:28rpx;font-weight:600;margin-bottom:12rpx;">修改桌台时间</view>
      <view style="margin-top:8rpx;font-size:24rpx;color:#334155;">开始时间</view>
      <picker mode="dateTime" value="{{editStart}}" bindchange="onEditStartChange">
        <view style="margin-top:8rpx;padding:12rpx;border:1px solid #e6e9ef;border-radius:8rpx;">{{editStart || '请选择开始时间'}}</view>
      </picker>
      <view style="margin-top:12rpx;font-size:24rpx;color:#334155;">结束时间（可不选）</view>
      <picker mode="dateTime" value="{{editEnd}}" bindchange="onEditEndChange">
        <view style="margin-top:8rpx;padding:12rpx;border:1px solid #e6e9ef;border-radius:8rpx;">{{editEnd || '请选择结束时间（可留空）'}}</view>
      </picker>
      <view style="display:flex;justify-content:flex-end;gap:12rpx;margin-top:16rpx;">
        <button type="default" bindtap="cancelEdit">取消</button>
        <button type="primary" bindtap="saveEdit">确定并保存</button>
      </view>
    </view>
  </view>
</block>
</view>
