page {
  background: #f5f7fb;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI', sans-serif;
}

/* 全局主按钮：浅橙色主题 */
button[type="primary"] {
  background-color: #ffa94d !important;
  color: #ffffff !important;
  border-radius: 14rpx;
}

button[type="primary"]::after {
  border: none;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}
